# Stream Bombarder configuration template.
#
# Copy this to ".env" (which is git-ignored) and adjust as needed. The app loads ".env" from the
# working directory if present. Precedence: CLI flag > environment variable > .env > default.
# Keys match the long CLI option names.

bootstrap-servers=localhost:9092,localhost:9093
schema-registry-url=http://localhost:8081
topic=accident.events
scale=1
# max-burst=100
# interval-ms=1000
# count=0
# duration-sec=0
