# Spring profile (shared)
# dev (default): verbose logging, auto schema, full health details
# prod: quiet logging, schema validated only, minimal health exposure
SPRING_PROFILES_ACTIVE=dev

# Kafka / Schema Registry (shared by all services)
BOOTSTRAP_SERVERS=localhost:9092,localhost:9093
SCHEMA_REGISTRY_URL=http://localhost:8081

# Postgres (consumer services)
# Local defaults below match the bundled Docker infra (infra/docker-compose.yml).
# In production, supply these via a secrets manager — do not hard-code.
POSTGRES_URL=jdbc:postgresql://localhost:5432/accident_management_service
POSTGRES_USER=test
POSTGRES_PASSWORD=postgres

# ── accident-event-stream (router) topics
SOURCE_TOPIC_NAME=accident.events
DLT_SOURCE_TOPIC_NAME=accident.events.dlt
EMERGENCY_SERVICE_TOPIC_NAME=emergency.events
POLICE_SERVICE_TOPIC_NAME=law-enforcement.events
FIRE_RESCUE_SERVICE_TOPIC_NAME=fire-rescue.events
STATISTICS_SERVICE_TOPIC_NAME=statistics.events

# Kafka Streams runtime
STATE_STORE_CACHE_MAX_SIZE=0
STATE_DIRECTORY=./state-dir
AVRO_SUBJECT_VERSION=latest

# Per-service HTTP ports (distinct so all can run on one host)
# emergency=18089  law-enforcement=28089  firerescue=38089  statistics=48089
