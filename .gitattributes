# Normalize line endings: LF in the repo, auto on checkout.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts must stay LF.
*.sh text eol=lf

# Treat binaries as binary (no EOL/diff munging).
*.jar binary
*.png binary
*.jpg binary
*.ico binary
*.drawio binary
